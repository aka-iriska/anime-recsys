        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    users ||--o{ user_anime_rates : \&quot;ведёт список\&quot;\n    users ||--o{ user_anime_history : \&quot;совершает события\&quot;\n    users ||--o{ user_favourites : \&quot;добавляет в избранное\&quot;\n    anime ||--o{ user_anime_rates : \&quot;оценивается\&quot;\n    anime ||--o{ user_anime_history : \&quot;затрагивается\&quot;\n    anime ||--o{ anime_genres : \&quot;\&quot;\n    genres ||--o{ anime_genres : \&quot;\&quot;\n    anime ||--o{ anime_studios : \&quot;\&quot;\n    studios ||--o{ anime_studios : \&quot;\&quot;\n    anime ||--o{ anime_relations : \&quot;источник связи\&quot;\n    anime ||--o{ anime_chronology : \&quot;seed и элемент\&quot;\n\n    users {\n        int user_id PK\n        string cohort \&quot;original | expanded\&quot;\n        string rates_access\n        int rates_http_status\n        string history_access\n        int history_http_status\n        string favourites_access\n        int favourites_http_status\n    }\n    anime {\n        int anime_id PK\n        int mal_id\n        string name\n        string russian\n        string english\n        string japanese\n        string synonyms\n        string description\n        float score \&quot;текущая оценка сайта\&quot;\n        string rating\n        string kind\n        string origin\n        string status\n        int episodes\n        int episodes_aired\n        int duration\n        string season\n        date aired_on\n        date released_on\n        string franchise\n    }\n    user_anime_rates {\n        int rate_id PK\n        int user_id FK\n        int anime_id FK \&quot;уникальна пара user_id+anime_id\&quot;\n        string target_type \&quot;всегда Anime\&quot;\n        int score \&quot;0 = нет оценки\&quot;\n        string status\n        int rewatches\n        int episodes\n        int volumes\n        int chapters\n        string text\n        string text_html\n        datetime created_at\n        datetime updated_at\n    }\n    user_anime_history {\n        int event_id PK\n        int user_id FK\n        int anime_id FK\n        datetime event_at\n        string description \&quot;тип события\&quot;\n    }\n    user_favourites {\n        int user_id FK\n        string category \&quot;PK вместе с target_id\&quot;\n        int target_id \&quot;аниме только при category=animes\&quot;\n        int position\n    }\n    genres {\n        int genre_id PK\n        string name\n        string russian\n        string kind\n        string entryType\n    }\n    anime_genres {\n        int anime_id FK\n        int genre_id FK\n    }\n    studios {\n        int studio_id PK\n        string studio_name\n    }\n    anime_studios {\n        int anime_id FK\n        int studio_id FK\n    }\n    anime_relations {\n        int anime_id FK\n        string target_type \&quot;Anime | Manga\&quot;\n        int target_id \&quot;не FK: может быть вне каталога или мангой\&quot;\n        string relation_kind\n    }\n    anime_chronology {\n        int seed_anime_id FK\n        int position\n        int anime_id \&quot;FK, но 1764 строки вне каталога\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ukfPufQZZeFNB0KgOa1H-1">
